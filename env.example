# Copy to .env and adjust as needed:  cp env.example .env

# Host port for the web UI (http://localhost:<WEB_PORT>)
WEB_PORT=8080

# Default statistical population for the estimator: nacional | quindio
ICFES_DEFAULT_POPULATION=quindio

# ETL only: national rows sampled per exam period (higher = more stable, slower)
ICFES_NATIONAL_CAP=25000
